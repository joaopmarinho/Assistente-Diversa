        "import gradio as gr\n",
        "import base64\n",
        "\n",
        "# ============================================================\n",
        "# IMAGENS DO FRONT\n",
        "# ============================================================\n",
        "\n",
        "CAMINHO_LOGO_ACCENTURE = \"./imagens_do_tcc/logo_accenture.png\"\n",
        "\n",
        "with open(CAMINHO_LOGO_ACCENTURE, \"rb\") as arquivo:\n",
        "    logo_accenture_base64 = base64.b64encode(arquivo.read()).decode(\"utf-8\")\n",
        "\n",
        "LOGO_ACCENTURE_URL = f\"data:image/png;base64,{logo_accenture_base64}\"\n",
        "\n",
        "CAMINHO_CORDAO = \"./imagens_do_tcc/CordaoTEA.svg\"\n",
        "\n",
        "with open(CAMINHO_CORDAO, \"rb\") as arquivo:\n",
        "    cordao_base64 = base64.b64encode(arquivo.read()).decode(\"utf-8\")\n",
        "\n",
        "CORDAO_TEA_URL = f\"data:image/svg+xml;base64,{cordao_base64}\"\n",
        "\n",
        "\n",
        "CAMINHO_ICONE_GRUPO = \"./imagens_do_tcc/images.svg\"\n",
        "\n",
        "with open(CAMINHO_ICONE_GRUPO, \"rb\") as arquivo:\n",
        "    icone_grupo_base64 = base64.b64encode(arquivo.read()).decode(\"utf-8\")\n",
        "\n",
        "ICONE_GRUPO_URL = f\"data:image/svg+xml;base64,{icone_grupo_base64}\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CSS PERSONALIZADO\n",
        "# ============================================================\n",
        "\n",
        "css_personalizado = f\"\"\"\n",
        "\n",
        "/* ============================================================\n",
        "   PALETA VISUAL - INSPIRADA NO ROXO DA ACCENTURE\n",
        "   ============================================================ */\n",
        "\n",
        ":root {{\n",
        "    --roxo-accenture: #A100FF;\n",
        "    --roxo-escuro: #6F00B8;\n",
        "    --roxo-claro: #F3E6FF;\n",
        "    --texto-principal: #111827;\n",
        "    --texto-secundario: #374151;\n",
        "    --borda-suave: #E5E7EB;\n",
        "    --fundo-pagina: #FAF7FF;\n",
        "    --branco: #FFFFFF;\n",
        "}}\n",
        "\n",
        "body {{\n",
        "    background:\n",
        "        radial-gradient(circle at top left, rgba(161, 0, 255, 0.10), transparent 32%),\n",
        "        var(--fundo-pagina);\n",
        "}}\n",
        "\n",
        ".gradio-container {{\n",
        "    max-width: 1200px !important;\n",
        "    margin: auto !important;\n",
        "    font-family: 'Inter', sans-serif !important;\n",
        "    background: transparent !important;\n",
        "}}\n",
        "\n",
        "/* ============================================================\n",
        "   ESTRUTURA PRINCIPAL\n",
        "   ============================================================ */\n",
        "\n",
        "#linha-principal {{\n",
        "    align-items: flex-start !important;\n",
        "    gap: 18px !important;\n",
        "}}\n",
        "\n",
        "#coluna-direita {{\n",
        "    display: flex;\n",
        "    flex-direction: column;\n",
        "    gap: 16px;\n",
        "}}\n",
        "\n",
        "/* ============================================================\n",
        "   BORDA COM CORDÃO\n",
        "   Aplica o cordão nas principais caixinhas do front.\n",
        "   ============================================================ */\n",
        "\n",
        "#hero,\n",
        "#chatbot,\n",
        ".card-info,\n",
        "#card-sugestoes,\n",
        "#pergunta-textbox {{\n",
        "    position: relative;\n",
        "    overflow: hidden;\n",
        "    background: var(--branco) !important;\n",
        "    box-shadow: 0 10px 28px rgba(17, 24, 39, 0.08);\n",
        "}}\n",
        "\n",
        "#hero::before,\n",
        "#chatbot::before,\n",
        ".card-info::before,\n",
        "#card-sugestoes::before,\n",
        "#pergunta-textbox::before {{\n",
        "    content: \"\";\n",
        "    position: absolute;\n",
        "    inset: 0;\n",
        "    background-image: url(\"{CORDAO_TEA_URL}\");\n",
        "    background-repeat: repeat;\n",
        "    background-position: center;\n",
        "    pointer-events: none;\n",
        "    z-index: 0;\n",
        "\n",
        "    -webkit-mask:\n",
        "        linear-gradient(#fff 0 0) content-box,\n",
        "        linear-gradient(#fff 0 0);\n",
        "    -webkit-mask-composite: xor;\n",
        "    mask-composite: exclude;\n",
        "}}\n",
        "\n",
        "/* Garante que o conteúdo fique acima da borda */\n",
        "#hero > *,\n",
        "#chatbot > *,\n",
        ".card-info > *,\n",
        "#card-sugestoes > *,\n",
        "#pergunta-textbox > * {{\n",
        "    position: relative;\n",
        "    z-index: 1;\n",
        "}}\n",
        "\n",
        "/* Caixa superior */\n",
        "#hero {{\n",
        "    border-radius: 28px;\n",
        "    padding: 34px;\n",
        "    color: var(--texto-principal);\n",
        "    margin-bottom: 24px;\n",
        "}}\n",
        "\n",
        "#hero::before {{\n",
        "    border-radius: 28px;\n",
        "    padding: 10px;\n",
        "    background-size: 180px;\n",
        "    opacity: 0.95;\n",
        "}}\n",
        "\n",
        "#hero h1 {{\n",
        "    font-size: 32px;\n",
        "    margin-bottom: 8px;\n",
        "    color: var(--texto-principal);\n",
        "}}\n",
        "\n",
        "#hero p {{\n",
        "    font-size: 16px;\n",
        "    line-height: 1.6;\n",
        "    color: var(--texto-secundario);\n",
        "    margin-bottom: 0;\n",
        "}}\n",
        "\n",
        ".icone-grupo {{\n",
        "    width: 44px;\n",
        "    height: 44px;\n",
        "    object-fit: contain;\n",
        "    margin-right: 12px;\n",
        "}}\n",
        "\n",
        ".titulo-grupo {{\n",
        "    display: flex;\n",
        "    align-items: center;\n",
        "    gap: 10px;\n",
        "    margin: 0;\n",
        "    color: var(--texto-principal);\n",
        "    font-size: 32px;\n",
        "}}\n",
        "\n",
        ".detalhe-roxo {{\n",
        "    color: var(--roxo-accenture) !important;\n",
        "    font-weight: 900;\n",
        "    font-size: 32px !important;\n",
        "    line-height: 1;\n",
        "}}\n",
        "\n",
        "/* Caixa do chat */\n",
        "#chatbot {{\n",
        "    border-radius: 24px !important;\n",
        "    background: #FFFFFF !important;\n",
        "    box-shadow: 0 8px 24px rgba(0,0,0,0.05);\n",
        "    position: relative;\n",
        "    overflow: hidden;\n",
        "    isolation: isolate;\n",
        "}}\n",
        "\n",
        "/* Marca d’água da Accenture dentro do chat */\n",
        "#chatbot::after {{\n",
        "    content: \"\";\n",
        "    position: absolute;\n",
        "    inset: 0;\n",
        "    background-image: url(\"{LOGO_ACCENTURE_URL}\");\n",
        "    background-repeat: no-repeat;\n",
        "    background-position: center center;\n",
        "    background-size: 220px auto;\n",
        "    opacity: 0.20;\n",
        "    pointer-events: none;\n",
        "    z-index: 1;\n",
        "}}\n",
        "\n",
        "/* Borda do cordão no chat */\n",
        "#chatbot::before {{\n",
        "    content: \"\";\n",
        "    position: absolute;\n",
        "    inset: 0;\n",
        "    border-radius: 24px;\n",
        "    padding: 9px;\n",
        "    background-image: url(\"{CORDAO_TEA_URL}\");\n",
        "    background-size: 160px;\n",
        "    background-repeat: repeat;\n",
        "    background-position: center;\n",
        "    opacity: 0.95;\n",
        "\n",
        "    -webkit-mask:\n",
        "        linear-gradient(#fff 0 0) content-box,\n",
        "        linear-gradient(#fff 0 0);\n",
        "    -webkit-mask-composite: xor;\n",
        "    mask-composite: exclude;\n",
        "\n",
        "    pointer-events: none;\n",
        "    z-index: 3;\n",
        "}}\n",
        "\n",
        "/* Garante que as mensagens fiquem acima da marca d’água */\n",
        "#chatbot > div {{\n",
        "    position: relative;\n",
        "    z-index: 2;\n",
        "}}\n",
        "\n",
        "/* ============================================================\n",
        "   CAMPO DE PERGUNTA\n",
        "   ============================================================ */\n",
        "\n",
        "#pergunta-textbox {{\n",
        "    border-radius: 20px !important;\n",
        "    margin-top: 14px !important;\n",
        "}}\n",
        "\n",
        "#pergunta-textbox::before {{\n",
        "    border-radius: 20px;\n",
        "    padding: 7px;\n",
        "    background-size: 130px;\n",
        "    opacity: 0.90;\n",
        "}}\n",
        "\n",
        "#pergunta-textbox label {{\n",
        "    color: var(--roxo-escuro) !important;\n",
        "    font-weight: 700 !important;\n",
        "}}\n",
        "\n",
        "#pergunta-textbox textarea,\n",
        "textarea {{\n",
        "    border-radius: 14px !important;\n",
        "    border: 1px solid rgba(161, 0, 255, 0.35) !important;\n",
        "    background: var(--branco) !important;\n",
        "    color: var(--texto-principal) !important;\n",
        "}}\n",
        "\n",
        "#pergunta-textbox textarea:focus,\n",
        "textarea:focus {{\n",
        "    border-color: var(--roxo-accenture) !important;\n",
        "    box-shadow: 0 0 0 3px rgba(161, 0, 255, 0.14) !important;\n",
        "}}\n",
        "\n",
        "/* ============================================================\n",
        "   CARDS LATERAIS\n",
        "   ============================================================ */\n",
        "\n",
        ".card-info,\n",
        "#card-sugestoes {{\n",
        "    border-radius: 22px;\n",
        "    padding: 22px !important;\n",
        "}}\n",
        "\n",
        ".card-info::before,\n",
        "#card-sugestoes::before {{\n",
        "    border-radius: 22px;\n",
        "    padding: 8px;\n",
        "    background-size: 135px;\n",
        "    opacity: 0.95;\n",
        "}}\n",
        "\n",
        ".card-info h3,\n",
        "#card-sugestoes h3 {{\n",
        "    color: var(--texto-principal);\n",
        "    margin-top: 0;\n",
        "    margin-bottom: 8px;\n",
        "}}\n",
        "\n",
        ".small-text {{\n",
        "    font-size: 14px;\n",
        "    color: var(--texto-secundario);\n",
        "    line-height: 1.6;\n",
        "}}\n",
        "\n",
        "#card-sugestoes .prose,\n",
        "#card-sugestoes .gr-markdown {{\n",
        "    margin: 0 !important;\n",
        "}}\n",
        "\n",
        "/* Lista com altura controlada para não passar demais da área do prompt */\n",
        "#lista-sugestoes {{\n",
        "    max-height: 210px;\n",
        "    overflow-y: auto;\n",
        "    padding-right: 4px;\n",
        "    margin-top: 10px;\n",
        "}}\n",
        "\n",
        "/* Espaço entre os botões de sugestão */\n",
        "#lista-sugestoes .pergunta-btn {{\n",
        "    margin-bottom: 10px !important;\n",
        "}}\n",
        "\n",
        "#lista-sugestoes .pergunta-btn:last-child {{\n",
        "    margin-bottom: 0 !important;\n",
        "}}\n",
        "\n",
        "/* ============================================================\n",
        "   BOTÕES EM ROXO\n",
        "   ============================================================ */\n",
        "\n",
        "button {{\n",
        "    border-radius: 14px !important;\n",
        "    font-weight: 700 !important;\n",
        "    transition: all 0.20s ease-in-out !important;\n",
        "}}\n",
        "\n",
        "/* Botão enviar - principal */\n",
        "#btn-enviar {{\n",
        "    background: linear-gradient(135deg, var(--roxo-accenture), var(--roxo-escuro)) !important;\n",
        "    color: white !important;\n",
        "    border: none !important;\n",
        "    box-shadow: 0 8px 18px rgba(161, 0, 255, 0.28) !important;\n",
        "}}\n",
        "\n",
        "#btn-enviar:hover {{\n",
        "    transform: translateY(-1px);\n",
        "    filter: brightness(0.95);\n",
        "    box-shadow: 0 10px 22px rgba(161, 0, 255, 0.36) !important;\n",
        "}}\n",
        "\n",
        "/* Botão limpar - secundário */\n",
        "#btn-limpar {{\n",
        "    background: var(--branco) !important;\n",
        "    color: var(--roxo-escuro) !important;\n",
        "    border: 1px solid rgba(161, 0, 255, 0.50) !important;\n",
        "}}\n",
        "\n",
        "#btn-limpar:hover {{\n",
        "    background: var(--roxo-claro) !important;\n",
        "    border-color: var(--roxo-accenture) !important;\n",
        "}}\n",
        "\n",
        "/* Perguntas sugeridas */\n",
        ".pergunta-btn button {{\n",
        "    width: 100% !important;\n",
        "    min-height: 44px;\n",
        "    padding: 10px 14px !important;\n",
        "    font-size: 15px !important;\n",
        "    line-height: 1.3;\n",
        "    white-space: normal !important;\n",
        "    text-align: left !important;\n",
        "\n",
        "    background: var(--branco) !important;\n",
        "    color: var(--roxo-escuro) !important;\n",
        "    border: 1px solid rgba(161, 0, 255, 0.42) !important;\n",
        "    box-shadow: 0 4px 12px rgba(17, 24, 39, 0.06) !important;\n",
        "}}\n",
        "\n",
        ".pergunta-btn button:hover {{\n",
        "    background: linear-gradient(135deg, var(--roxo-accenture), var(--roxo-escuro)) !important;\n",
        "    color: white !important;\n",
        "    border-color: var(--roxo-accenture) !important;\n",
        "    transform: translateY(-1px);\n",
        "}}\n",
        "\n",
        "/* ============================================================\n",
        "   AJUSTES FINOS DO GRADIO\n",
        "   ============================================================ */\n",
        "\n",
        "label {{\n",
        "    color: var(--texto-principal) !important;\n",
        "}}\n",
        "\n",
        ".footer {{\n",
        "    text-align: center;\n",
        "    color: #6B7280;\n",
        "    font-size: 13px;\n",
        "    margin-top: 18px;\n",
        "}}\n",
        "\n",
        "/* Responsivo */\n",
        "@media (max-width: 900px) {{\n",
        "    #linha-principal {{\n",
        "        flex-direction: column !important;\n",
        "    }}\n",
        "\n",
        "    #lista-sugestoes {{\n",
        "        max-height: 260px;\n",
        "    }}\n",
        "}}\n",
        "/* ============================================================\n",
        "   AJUSTE PARA USAR MAIS A TELA E AUMENTAR AS LETRAS\n",
        "   ============================================================ */\n",
        "\n",
        "html, body {{\n",
        "    width: 100%;\n",
        "    min-height: 100%;\n",
        "    background: #FAFAFA !important;\n",
        "}}\n",
        "\n",
        "/* Usa quase a tela inteira */\n",
        ".gradio-container {{\n",
        "    max-width: 96vw !important;\n",
        "    width: 96vw !important;\n",
        "    margin: 0 auto !important;\n",
        "    padding: 18px 28px !important;\n",
        "    font-family: 'Inter', sans-serif !important;\n",
        "    background: #FAFAFA !important;\n",
        "}}\n",
        "\n",
        "/* Linha principal mais espaçada */\n",
        "#linha-principal {{\n",
        "    width: 100% !important;\n",
        "    gap: 28px !important;\n",
        "    align-items: flex-start !important;\n",
        "}}\n",
        "\n",
        "/* Aumenta a área do chat */\n",
        "#chatbot {{\n",
        "    min-height: 560px !important;\n",
        "    height: 58vh !important;\n",
        "}}\n",
        "\n",
        "/* Aumenta letras dentro do chat */\n",
        "#chatbot,\n",
        "#chatbot * {{\n",
        "    font-size: 17px !important;\n",
        "    line-height: 1.6 !important;\n",
        "}}\n",
        "\n",
        "/* Aumenta o campo de pergunta */\n",
        "#pergunta-textbox textarea {{\n",
        "    font-size: 17px !important;\n",
        "    line-height: 1.5 !important;\n",
        "    min-height: 80px !important;\n",
        "    padding: 16px !important;\n",
        "}}\n",
        "\n",
        "/* Aumenta os labels */\n",
        "#pergunta-textbox label,\n",
        "#chatbot label {{\n",
        "    font-size: 16px !important;\n",
        "    font-weight: 700 !important;\n",
        "}}\n",
        "\n",
        "/* Aumenta os botões principais */\n",
        "#btn-enviar button,\n",
        "#btn-limpar button,\n",
        "button {{\n",
        "    font-size: 16px !important;\n",
        "    min-height: 48px !important;\n",
        "}}\n",
        "\n",
        "/* Aumenta texto dos cards laterais */\n",
        ".card-info,\n",
        "#card-sugestoes,\n",
        ".small-text {{\n",
        "    font-size: 16px !important;\n",
        "    line-height: 1.6 !important;\n",
        "}}\n",
        "\n",
        "/* Aumenta perguntas sugeridas */\n",
        ".pergunta-btn button {{\n",
        "    font-size: 16px !important;\n",
        "    min-height: 56px !important;\n",
        "    padding: 14px 16px !important;\n",
        "}}\n",
        "\n",
        "/* Título maior */\n",
        ".titulo-grupo {{\n",
        "    font-size: 36px !important;\n",
        "}}\n",
        "\n",
        "#hero p {{\n",
        "    font-size: 17px !important;\n",
        "}}\n",
        "\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# FUNÇÕES DO CHAT\n",
        "# ============================================================\n",
        "# IMPORTANTE:\n",
        "# A função responder(mensagem) precisa estar criada antes deste bloco.\n",
        "# Ela é a função do seu RAG/Groq que gera a resposta do assistente.\n",
        "# ============================================================\n",
        "\n",
        "def enviar_mensagem(mensagem, historico):\n",
        "    if historico is None:\n",
        "        historico = []\n",
        "\n",
        "    if not mensagem or not mensagem.strip():\n",
        "        return \"\", historico\n",
        "\n",
        "    resposta = responder(mensagem)\n",
        "\n",
        "    # Formato correto para o seu Gradio:\n",
        "    # cada mensagem precisa ter role e content\n",
        "    historico.append({\n",
        "        \"role\": \"user\",\n",
        "        \"content\": mensagem\n",
        "    })\n",
        "\n",
        "    historico.append({\n",
        "        \"role\": \"assistant\",\n",
        "        \"content\": resposta\n",
        "    })\n",
        "\n",
        "    return \"\", historico\n",
        "\n",
        "\n",
        "def limpar_chat():\n",
        "    return []\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# TEMA DO GRADIO\n",
        "# ============================================================\n",
        "\n",
        "tema = gr.themes.Soft(\n",
        "    primary_hue=\"purple\",\n",
        "    neutral_hue=\"slate\",\n",
        "    font=gr.themes.GoogleFont(\"Inter\")\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# INTERFACE\n",
        "# ============================================================\n",
        "\n",
        "with gr.Blocks(\n",
        "    theme=tema,\n",
        "    css=css_personalizado,\n",
        "    title=\"Assistente Diversa — Educação Inclusiva\"\n",
        ") as demo:\n",
        "\n",
        "    gr.HTML(f\"\"\"\n",
        "<div id=\"hero\">\n",
        "    <h1 class=\"titulo-grupo\">\n",
        "        <img src=\"{ICONE_GRUPO_URL}\" class=\"icone-grupo\">\n",
        "        <span>Acessibilidade Inteligente</span>\n",
        "        <span class=\"detalhe-roxo\">&gt;</span>\n",
        "    </h1>\n",
        "\n",
        "    <p>\n",
        "        Equipe Hélice\n",
        "    </p>\n",
        "</div>\n",
        "\"\"\")\n",
        "\n",
        "    with gr.Row(elem_id=\"linha-principal\"):\n",
        "\n",
        "        with gr.Column(scale=4):\n",
        "            chatbot = gr.Chatbot(\n",
        "                label=\"Assistente Diversa\",\n",
        "                elem_id=\"chatbot\",\n",
        "                height=560\n",
        "            )\n",
        "\n",
        "            pergunta = gr.Textbox(\n",
        "                label=\"Digite sua pergunta\",\n",
        "                placeholder=\"Exemplo: O que é AEE? Como incluir um aluno com TEA?\",\n",
        "                lines=3,\n",
        "                elem_id=\"pergunta-textbox\"\n",
        "            )\n",
        "\n",
        "            with gr.Row():\n",
        "                btn_enviar = gr.Button(\"Enviar pergunta\", elem_id=\"btn-enviar\")\n",
        "                btn_limpar = gr.Button(\"Limpar conversa\", elem_id=\"btn-limpar\")\n",
        "\n",
        "        with gr.Column(scale=1, elem_id=\"coluna-direita\"):\n",
        "\n",
        "            gr.HTML(\"\"\"\n",
        "            <div class=\"card-info\">\n",
        "                <h3>📚 Sobre o protótipo</h3>\n",
        "                <p class=\"small-text\">\n",
        "                    Este assistente responde com base em uma base de conhecimento\n",
        "                    cadastrada manualmente com fontes reais sobre educação inclusiva.\n",
        "                </p>\n",
        "                <p class=\"small-text\">\n",
        "                    Ele não substitui professores, profissionais do AEE, médicos,\n",
        "                    psicólogos ou especialistas.\n",
        "                </p>\n",
        "            </div>\n",
        "            \"\"\")\n",
        "\n",
        "            # Agora o card de sugestões envolve o título E os botões.\n",
        "            # Assim a borda com o cordão aparece em volta de toda a caixinha.\n",
        "            with gr.Column(elem_id=\"card-sugestoes\"):\n",
        "                gr.HTML(\"\"\"\n",
        "                <h3>✅ Perguntas sugeridas</h3>\n",
        "                <p class=\"small-text\">\n",
        "                    Clique em uma pergunta para preencher o campo de texto.\n",
        "                </p>\n",
        "                \"\"\")\n",
        "\n",
        "                with gr.Column(elem_id=\"lista-sugestoes\"):\n",
        "                    btn_p1 = gr.Button(\"O que é educação inclusiva?\", elem_classes=\"pergunta-btn\")\n",
        "                    btn_p2 = gr.Button(\"O que é AEE?\", elem_classes=\"pergunta-btn\")\n",
        "                    btn_p3 = gr.Button(\"Como incluir aluno com TEA?\", elem_classes=\"pergunta-btn\")\n",
        "\n",
        "\n",
        "    gr.HTML(\"\"\"\n",
        "    <div class=\"footer\">\n",
        "        Projeto acadêmico desenvolvido para fins educacionais — SoulCode / Accenture\n",
        "    </div>\n",
        "    \"\"\")\n",
        "\n",
        "    # ========================================================\n",
        "    # EVENTOS DOS BOTÕES PRINCIPAIS\n",
        "    # ========================================================\n",
        "\n",
        "    btn_enviar.click(\n",
        "        fn=enviar_mensagem,\n",
        "        inputs=[pergunta, chatbot],\n",
        "        outputs=[pergunta, chatbot]\n",
        "    )\n",
        "\n",
        "    pergunta.submit(\n",
        "        fn=enviar_mensagem,\n",
        "        inputs=[pergunta, chatbot],\n",
        "        outputs=[pergunta, chatbot]\n",
        "    )\n",
        "\n",
        "    btn_limpar.click(\n",
        "        fn=limpar_chat,\n",
        "        inputs=[],\n",
        "        outputs=[chatbot]\n",
        "    )\n",
        "\n",
        "    # ========================================================\n",
        "    # EVENTOS DAS PERGUNTAS SUGERIDAS\n",
        "    # Elas apenas preenchem o campo de pergunta.\n",
        "    # Depois clique em \"Enviar pergunta\".\n",
        "    # ========================================================\n",
        "\n",
        "    btn_p1.click(\n",
        "        fn=lambda: \"O que é educação inclusiva?\",\n",
        "        inputs=[],\n",
        "        outputs=[pergunta]\n",
        "    )\n",
        "\n",
        "    btn_p2.click(\n",
        "        fn=lambda: \"O que é Atendimento Educacional Especializado?\",\n",
        "        inputs=[],\n",
        "        outputs=[pergunta]\n",
        "    )\n",
        "\n",
        "    btn_p3.click(\n",
        "        fn=lambda: \"Como incluir um aluno com TEA em sala de aula?\",\n",
        "        inputs=[],\n",
        "        outputs=[pergunta]\n",
        "    )\n",
        "\n",
        "\n",
        "demo.launch(\n",
        "    share=True,\n",
        "    inbrowser=True\n",
        ")"
      ]
    }
